# Copy to .env.local for local development only.
# Set Netlify runtime secrets in the UI/API with Functions scope.
# Missing preview credentials DENY access, including production.
PREVIEW_ACCESS_USERNAME=
PREVIEW_ACCESS_PASSWORD=

# Public Supabase connection values. These are safe to expose; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Netlify AI Gateway injects GEMINI_API_KEY and GOOGLE_GEMINI_BASE_URL at runtime.
# Stripe remains disabled until a sandbox account is connected.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
