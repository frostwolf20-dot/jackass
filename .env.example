# Copy to .env.local for local development only.
# Set Netlify runtime secrets in the UI/API with Functions scope.
# Missing preview credentials DENY access, including production.
PREVIEW_ACCESS_USERNAME=
PREVIEW_ACCESS_PASSWORD=

# Reserved for later integrations. No integration is enabled by these placeholders.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
OCR_ENDPOINT=
OCR_API_KEY=
